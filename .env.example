# Discord Bot
DISCORD_TOKEN="hoge"
DISCORD_GUILD_ID=1234567890123456789
BOT_PORT=5174
# 稼働環境（production のときは SHARED_SECRET が16文字未満だと起動しない）
BOT_ENV=development

# Discord Roles (Set your actual role IDs from the Discord server)
# 会員種別はロール名ではなくロール ID で判定する（Backend / Bot 共通）。*_ROLE_IDS はカンマ区切りで複数指定可
# Backend: PRE_MEMBER_ROLE_ID / MEMBER_ROLE_IDS / ADMIN_ROLE_IDS は必須（FASTAPI_ENV=production で未設定だと起動しない）
PRE_MEMBER_ROLE_ID=1234567890123456789
MEMBER_ROLE_IDS=1234567890123456789
ADMIN_ROLE_IDS=1234567890123456789
# 任意。未設定の種別は「Discord から同期」で user_memberships を更新しない
OBOG_ROLE_IDS=1234567890123456789
# sub垢 ロール（任意）
SUB_USER_ROLE_IDS=1234567890123456789

# Shared settings
# Backend が Discord Bot に同期を依頼する URL（`/internal/sync` まで含めても、ホストまででもよい）
BOT_INTERNAL_URL=http://discord-bot:8000/internal/sync
SHARED_SECRET=dev-secret
BACKEND_URL=http://backend:5174

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://fuga.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=hoge

SUPABASE_SERVICE_ROLE_KEY=hoge
SUPABASE_JWT_SECRET=hoge
NEXT_PUBLIC_SUPABASE_REDIRECT_URL=http://127.0.0.1:5173/auth/callback

# Database (Supabase pooler connection; Docker環境でIPv4経路を使う)
DATABASE_URL=postgresql://postgres.fuga:hoge@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres

# Backend DB connection pool (optional; values below are the defaults)
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300

# Discord OAuth (configure same values in Supabase Auth → Providers → Discord)
DISCORD_CLIENT_ID=1234567890123456789
DISCORD_CLIENT_SECRET=hoge
DISCORD_INVITE_CHANNEL_ID=1234567890123456789

# App
# false は開発環境でのみ使用可（本番の frontend は起動しない）
AUTH_REQUIRED=true

# Frontend Backend URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:5174

# Brevo (Sendinblue)
BREVO_API_KEY=hoge
BREVO_SENDER_EMAIL=noreply@digitart.jp
BREVO_SENDER_NAME=digitart Technology Association
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:5173
