# Discord Bot
DISCORD_TOKEN="hoge"
DISCORD_GUILD_ID=1234567890123456789
BOT_PORT=8000

# Discord Roles (Set your actual role IDs from the Discord server)
PRE_MEMBER_ROLE_ID=1234567890123456789
MEMBER_ROLE_IDS=1234567890123456789
ADMIN_ROLE_IDS=1234567890123456789

# Shared settings
SHARED_SECRET=dev-secret
BACKEND_URL=http://backend:8000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://fuga.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=hoge

SUPABASE_SERVICE_ROLE_KEY=hoge
SUPABASE_JWT_SECRET=hoge

# Database (Supabase pooler connection; Docker環境でIPv4経路を使う)
DATABASE_URL=postgresql://postgres.fuga:hoge@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres

# Backend DB connection pool (optional; values below are the defaults)
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300

# Discord OAuth (configure same values in Supabase Auth → Providers → Discord)
DISCORD_CLIENT_ID=1234567890123456789
DISCORD_CLIENT_SECRET=hoge
DISCORD_INVITE_CHANNEL_ID=1234567890123456789

# App
AUTH_REQUIRED=true

# Brevo (Sendinblue)
BREVO_API_KEY=hoge
BREVO_SENDER_EMAIL=noreply@digitart.jp
BREVO_SENDER_NAME=digitart Technology Association
